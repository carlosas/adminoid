# Copy to .env and adjust. Never commit .env.
# Paths accept ~ for the home directory.

# Project Zomboid data directory (contains Server/, db/, Saves/)
PZ_DATA_DIR=~/Zomboid
# Dedicated server install directory (contains start-server.sh)
PZ_GAME_DIR=~/zomboid-server/server
# SteamCMD launcher used for updates
PZ_STEAMCMD=~/zomboid-server/steamcmd/steamcmd.sh
# Where backups are written
PZ_BACKUP_DIR=~/zomboid-backups
# Server name passed as -servername (files are <name>.ini, <name>_SandboxVars.lua, ...)
PZ_SERVER_NAME=servertest

# Panel listen address: use this machine's LAN IP to reach it from the LAN.
# Do not expose it to the Internet: it is plain HTTP.
PANEL_BIND=127.0.0.1
PANEL_PORT=8080
# Client network allowed to use the panel (CIDR). Empty: only localhost.
PANEL_ALLOWED_NETWORK=192.168.1.0/24
